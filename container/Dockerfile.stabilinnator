# Base Docker image for stabiliNNator
# Contains PyTorch, PyTorch Geometric, and the stabiliNNator tools
#
# Build:
#   docker build --platform linux/amd64 -t dxkb/stabilinnator:latest-gpu -f Dockerfile.stabilinnator .
#
# Run proliNNator:
#   docker run --gpus all -v $(pwd)/data:/data dxkb/stabilinnator:latest-gpu \
#     prolinnator --pdb-path /data/input.pdb --output-path /data/output_proline.pdb
#
# Run disulfiNNate:
#   docker run --gpus all -v $(pwd)/data:/data dxkb/stabilinnator:latest-gpu \
#     disulfinnate --pdb-path /data/input.pdb --output-path /data/output_disulfide.pdb

# Pin to specific commit for reproducibility
# https://github.com/schoederlab/stabiliNNator/commit/28f0fc99b12be333d7143bd560f9279ce1374caa
ARG STABILINNATOR_VERSION=28f0fc99b12be333d7143bd560f9279ce1374caa
ARG CUDA_VERSION=11.8.0

FROM nvidia/cuda:${CUDA_VERSION}-cudnn8-runtime-ubuntu22.04 AS gpu

# Build arguments for metadata
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG VERSION=1.0.0

# Standard OCI labels
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/CEPI-dxkb/stabiliNNatorApp"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.title="stabiliNNator"
LABEL org.opencontainers.image.description="GNN-based protein stability prediction (proline mutations and disulfide bonds)"
LABEL org.opencontainers.image.vendor="BV-BRC"
LABEL org.opencontainers.image.licenses="MIT"

# Application-specific labels
LABEL maintainer="BV-BRC Team"
LABEL app.name="StabiliNNator"
LABEL app.version="${VERSION}"
LABEL build.date="${BUILD_DATE}"
LABEL build.git.commit="${GIT_COMMIT}"
LABEL build.git.branch="${GIT_BRANCH}"

# Set environment
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    gcc \
    g++ \
    libopenblas-dev \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create symlink for python
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Install PyTorch with CUDA support
RUN pip3 install --no-cache-dir \
    torch==2.1.0 \
    torchvision==0.16.0 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu118

# Install dependencies - using pyg-lib and torch_geometric approach from original stabiliNNator
# Pin numpy<2 for PyTorch 2.1 compatibility
# Use torch-geometric 1.7.2 which has the old GATConv API (single lin layer)
RUN pip3 install --no-cache-dir \
    "numpy>=1.24.0,<2.0.0" \
    torch-scatter -f https://data.pyg.org/whl/torch-2.1.0+cu118.html && \
    pip3 install --no-cache-dir \
    torch-sparse -f https://data.pyg.org/whl/torch-2.1.0+cu118.html && \
    pip3 install --no-cache-dir \
    torch-cluster -f https://data.pyg.org/whl/torch-2.1.0+cu118.html && \
    pip3 install --no-cache-dir \
    torch-spline-conv -f https://data.pyg.org/whl/torch-2.1.0+cu118.html && \
    pip3 install --no-cache-dir \
    torch-geometric==2.4.0 \
    biopython>=1.81 \
    matplotlib>=3.7.0 \
    scikit-learn>=1.2.0

# Clone stabiliNNator from GitHub
ARG STABILINNATOR_VERSION
RUN git clone https://github.com/schoederlab/stabiliNNator.git /opt/stabilinnator \
    && cd /opt/stabilinnator \
    && git checkout ${STABILINNATOR_VERSION}

# Copy checkpoint conversion script and convert old model format to new PyTorch Geometric format
COPY convert_checkpoint.py /tmp/convert_checkpoint.py
RUN python /tmp/convert_checkpoint.py \
    /opt/stabilinnator/proliNNator/models/proline_gat.pt \
    /opt/stabilinnator/proliNNator/models/proline_gat_converted.pt \
    && mv /opt/stabilinnator/proliNNator/models/proline_gat_converted.pt \
       /opt/stabilinnator/proliNNator/models/proline_gat.pt \
    && python /tmp/convert_checkpoint.py \
       /opt/stabilinnator/disulfiNNate/models/cys_gat.pt \
       /opt/stabilinnator/disulfiNNate/models/cys_gat_converted.pt \
    && mv /opt/stabilinnator/disulfiNNate/models/cys_gat_converted.pt \
       /opt/stabilinnator/disulfiNNate/models/cys_gat.pt \
    && rm /tmp/convert_checkpoint.py

# Set working directory
WORKDIR /opt/stabilinnator

# Set default model paths
ENV STABILINNATOR_DIR=/opt/stabilinnator
ENV PROLINNATOR_MODEL=/opt/stabilinnator/proliNNator/models/proline_gat.pt
ENV DISULFINNATE_MODEL=/opt/stabilinnator/disulfiNNate/models/cys_gat.pt

# Create wrapper scripts for easier invocation (with default model paths and hidden_dim)
# Note: proliNNator model was trained with hidden_dim=32, not the script default of 128
RUN echo '#!/bin/bash\n\
MODEL_PATH="${PROLINNATOR_MODEL:-/opt/stabilinnator/proliNNator/models/proline_gat.pt}"\n\
ARGS=""\n\
[[ "$*" != *"--model-path"* ]] && ARGS="$ARGS --model-path $MODEL_PATH"\n\
[[ "$*" != *"--hidden-dim"* ]] && ARGS="$ARGS --hidden-dim 32"\n\
exec python /opt/stabilinnator/proliNNator/proliNNator.py $ARGS "$@"' > /usr/local/bin/prolinnator && \
    chmod +x /usr/local/bin/prolinnator

RUN echo '#!/bin/bash\n\
MODEL_PATH="${DISULFINNATE_MODEL:-/opt/stabilinnator/disulfiNNate/models/cys_gat.pt}"\n\
ARGS=""\n\
[[ "$*" != *"--model-path"* ]] && ARGS="$ARGS --model-path $MODEL_PATH"\n\
[[ "$*" != *"--hidden-dim"* ]] && ARGS="$ARGS --hidden-dim 32"\n\
exec python /opt/stabilinnator/disulfiNNate/predict_cysteine_probabilities.py $ARGS "$@"' > /usr/local/bin/disulfinnate && \
    chmod +x /usr/local/bin/disulfinnate

# Create combined wrapper
RUN echo '#!/bin/bash\n\
case "$1" in\n\
    proline|prolinnator)\n\
        shift\n\
        exec prolinnator "$@"\n\
        ;;\n\
    disulfide|disulfinnate)\n\
        shift\n\
        exec disulfinnate "$@"\n\
        ;;\n\
    both)\n\
        shift\n\
        echo "Running proliNNator..."\n\
        prolinnator "$@"\n\
        echo "Running disulfiNNate..."\n\
        disulfinnate "$@"\n\
        ;;\n\
    *)\n\
        echo "Usage: stabilinnator {proline|disulfide|both} [options]"\n\
        echo ""\n\
        echo "Commands:"\n\
        echo "  proline    Run proline probability prediction"\n\
        echo "  disulfide  Run disulfide bond prediction"\n\
        echo "  both       Run both analyses"\n\
        exit 1\n\
        ;;\n\
esac' > /usr/local/bin/stabilinnator && \
    chmod +x /usr/local/bin/stabilinnator

# Data directory
WORKDIR /data

# Default command
CMD ["stabilinnator"]
