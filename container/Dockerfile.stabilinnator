# Base Docker image for stabiliNNator
# Contains PyTorch, PyTorch Geometric, and the stabiliNNator tools
#
# Build:
#   docker build --platform linux/amd64 -t dxkb/stabilinnator:latest-gpu -f Dockerfile.stabilinnator .
#
# Run proliNNator:
#   docker run --gpus all -v $(pwd)/data:/data dxkb/stabilinnator:latest-gpu \
#     python /opt/stabilinnator/proliNNator/proliNNator.py \
#     --model-path /opt/stabilinnator/proliNNator/models/proline_gat.pt \
#     --pdb-path /data/input.pdb \
#     --output-path /data/output_proline.pdb
#
# Run disulfiNNate:
#   docker run --gpus all -v $(pwd)/data:/data dxkb/stabilinnator:latest-gpu \
#     python /opt/stabilinnator/disulfiNNate/predict_cysteine_probabilities.py \
#     --model-path /opt/stabilinnator/disulfiNNate/models/cys_gat.pt \
#     --pdb-path /data/input.pdb \
#     --output-path /data/output_disulfide.pdb

FROM nvidia/cuda:11.8.0-cudnn8-runtime-ubuntu22.04

# Build arguments for metadata
ARG BUILD_DATE=unknown
ARG GIT_COMMIT=unknown
ARG GIT_BRANCH=unknown
ARG VERSION=1.0.0

# Standard OCI labels
LABEL org.opencontainers.image.created="${BUILD_DATE}"
LABEL org.opencontainers.image.revision="${GIT_COMMIT}"
LABEL org.opencontainers.image.source="https://github.com/CEPI-dxkb/stabiliNNatorApp"
LABEL org.opencontainers.image.version="${VERSION}"
LABEL org.opencontainers.image.title="stabiliNNator"
LABEL org.opencontainers.image.description="GNN-based protein stability prediction (proline mutations and disulfide bonds)"
LABEL org.opencontainers.image.vendor="BV-BRC"
LABEL org.opencontainers.image.licenses="MIT"

# Application-specific labels
LABEL maintainer="BV-BRC Team"
LABEL app.name="StabiliNNator"
LABEL app.version="${VERSION}"
LABEL build.date="${BUILD_DATE}"
LABEL build.git.commit="${GIT_COMMIT}"
LABEL build.git.branch="${GIT_BRANCH}"

# Set environment
ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    wget \
    git \
    gcc \
    g++ \
    libopenblas-dev \
    python3 \
    python3-pip \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Create symlink for python
RUN ln -sf /usr/bin/python3 /usr/bin/python

# Install PyTorch with CUDA support
RUN pip3 install --no-cache-dir \
    torch==2.1.0 \
    torchvision==0.16.0 \
    torchaudio==2.1.0 \
    --index-url https://download.pytorch.org/whl/cu118

# Install PyTorch Geometric and dependencies
RUN pip3 install --no-cache-dir \
    torch-scatter \
    torch-sparse \
    torch-cluster \
    torch-spline-conv \
    -f https://data.pyg.org/whl/torch-2.1.0+cu118.html

RUN pip3 install --no-cache-dir \
    torch-geometric==2.4.0 \
    biopython>=1.81 \
    numpy>=1.24.0 \
    matplotlib>=3.7.0 \
    scikit-learn>=1.2.0

# Create directory for stabiliNNator
RUN mkdir -p /opt/stabilinnator

# Copy stabiliNNator source code (from build context or mounted)
# Note: In production, this would clone from GitHub or copy from build context
COPY proliNNator/ /opt/stabilinnator/proliNNator/
COPY disulfiNNate/ /opt/stabilinnator/disulfiNNate/

# Set working directory
WORKDIR /opt/stabilinnator

# Create wrapper scripts for easier invocation
RUN echo '#!/bin/bash\n\
python /opt/stabilinnator/proliNNator/proliNNator.py "$@"' > /usr/local/bin/prolinnator && \
    chmod +x /usr/local/bin/prolinnator

RUN echo '#!/bin/bash\n\
python /opt/stabilinnator/disulfiNNate/predict_cysteine_probabilities.py "$@"' > /usr/local/bin/disulfinnate && \
    chmod +x /usr/local/bin/disulfinnate

# Create combined wrapper
RUN echo '#!/bin/bash\n\
case "$1" in\n\
    proline|prolinnator)\n\
        shift\n\
        exec prolinnator "$@"\n\
        ;;\n\
    disulfide|disulfinnate)\n\
        shift\n\
        exec disulfinnate "$@"\n\
        ;;\n\
    both)\n\
        shift\n\
        echo "Running proliNNator..."\n\
        prolinnator "$@"\n\
        echo "Running disulfiNNate..."\n\
        disulfinnate "$@"\n\
        ;;\n\
    *)\n\
        echo "Usage: stabilinnator {proline|disulfide|both} [options]"\n\
        echo ""\n\
        echo "Commands:"\n\
        echo "  proline    Run proline probability prediction"\n\
        echo "  disulfide  Run disulfide bond prediction"\n\
        echo "  both       Run both analyses"\n\
        exit 1\n\
        ;;\n\
esac' > /usr/local/bin/stabilinnator && \
    chmod +x /usr/local/bin/stabilinnator

# Data directory
WORKDIR /data

# Default command
CMD ["stabilinnator"]
